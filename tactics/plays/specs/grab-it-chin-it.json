  "notes": {
    "title": "Grab It, Chin It (also: Two-Hand Rebound Drill, Rebound Toss, Chin It)",
    "category": "Rebounding",
    "ages": "U6, U8, U10",
    "players": "Any",
    "duration": "5–8 min",
    "objective": "Teaches the first rebound habits: jump, grab with two hands at the top, and protect the ball under the chin.",
    "setup": [
      "Players in a line near the block, or in pairs anywhere on the court",
      "Coach with a ball under the basket"
    ],
    "rules": [
      "Part 1 (self-toss): each player tosses the ball a little above their head, jumps, catches it with two hands, and lands with the ball under their chin, elbows out, yelling \"Ball!\".",
      "Part 2 (coach toss): coach tosses the ball off the backboard; the first player in line jumps, grabs it with two hands, chins it, and hands it back.",
      "Part 3: after the grab, pivot away and make a pass to a teammate on the wing."
    ],
    "variations": [
      "Easier: catch the ball after one bounce.",
      "Harder: two players go for the coach’s toss — whoever chins it gets a point.",
      "Harder: rebound, chin it, then score a power layup."
    ],
    "coaching": [
      "Two hands, grab it hard.",
      "Catch it at the top of your jump.",
      "Chin it — elbows out.",
      "Yell \"Ball!\"."
    ],
    "equipment": [
      "1 ball per player or pair",
      "1 basket"
    ]
  }
}
