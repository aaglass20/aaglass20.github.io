  "notes": {
    "title": "Stay in Front (Lane 1v1) (also: Wall Defense, Mirror Lane 1v1, Walk-Dribble Defense)",
    "category": "Defense, 1v1, Footwork",
    "ages": "U6, U8, U10",
    "players": "Pairs",
    "duration": "6–8 min",
    "objective": "Young defenders learn to slide and keep the dribbler in front of them inside a narrow lane, at a walking pace first.",
    "setup": [
      "Lanes about 3–4 steps wide marked with cones, from baseline to half court",
      "Pairs: one dribbler, one defender facing them at the baseline"
    ],
    "rules": [
      "Dribbler walks forward, zig-zagging from side to side of the lane.",
      "Defender slides to stay in front, chest to the ball — no reaching.",
      "At half court, swap roles and come back.",
      "Round 2: dribbler may jog; defender scores a point for each time they stop the dribbler’s path with their body (not hands)."
    ],
    "variations": [
      "Easier: dribbler carries the ball (no dribble) and just walks.",
      "Harder: narrower lane; dribbler may go full speed and try to beat the defender to the half-court line.",
      "Harder: defender may try to tap the ball once it’s past their hip — \"poke from behind\"."
    ],
    "coaching": [
      "Nose on the ball.",
      "Slide, slide — don’t cross your feet.",
      "Beat them to the spot with your feet, not your hands.",
      "Stay low the whole lane."
    ],
    "equipment": [
      "1 ball per pair",
      "Cones"
    ]
  }
