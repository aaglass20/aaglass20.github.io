  "notes": {
    "title": "Slide and Touch Relay (also: Defensive Slide Relay, Cone Slide Race)",
    "category": "Conditioning, Defense, Fun",
    "ages": "U6, U8, U10",
    "players": "3–4 per team",
    "duration": "5–8 min",
    "objective": "A relay race that sneaks in defensive slides and conditioning — kids slide cone to cone and touch each one.",
    "setup": [
      "Teams of 3–4 in lines on the baseline",
      "In front of each team, 4 cones in a zig-zag about 3 steps apart, ending at the free-throw line"
    ],
    "rules": [
      "On \"Go\", the first player slides (no crossing feet) to each cone and touches it with the outside hand.",
      "After the last cone, sprint straight back and high-five the next teammate.",
      "First team to finish sits down in stance; play best of 3."
    ],
    "variations": [
      "Easier: fewer cones, wider spacing.",
      "Harder: carry a ball in two hands on the way out, dribble it back.",
      "Harder: backpedal between cones instead of sprinting the return."
    ],
    "coaching": [
      "Push off the back foot — step-slide.",
      "Stay low; your head shouldn’t bob up.",
      "Touch the cone, don’t knock it over."
    ],
    "equipment": [
      "Cones",
      "Optional 1 ball per team"
    ]
  }
