  "notes": {
    "title": "Coach Says: Defense (also: Simon Says Defense, Defensive Stance Freeze)",
    "category": "Defense, Footwork, Fun",
    "ages": "U6, U8",
    "players": "Any",
    "duration": "5 min",
    "objective": "A Simon Says game that teaches young players a real defensive stance, slides, and active hands without it feeling like a drill.",
    "setup": [
      "Players spread out on the baseline or in a loose grid, facing the coach",
      "Arm’s length of space all around each player"
    ],
    "rules": [
      "Teach the commands first: \"Stance\" (feet wide, knees bent, hands out), \"Slide left / right\", \"Hands up\", \"Hands down low\", \"Back up\", \"Sprint\".",
      "Coach calls \"Coach says stance!\" and players drop into stance.",
      "Mix in commands with and without \"Coach says\"; anyone who moves on a trick call does 3 quick toe-taps and stays in.",
      "Finish each round with \"Coach says shot!\" — players jump with one hand straight up to contest."
    ],
    "variations": [
      "Easier: coach does every move with the players (follow the leader).",
      "Harder: point instead of talking — players react to hand signals only.",
      "Harder: add a ball — on \"Steal!\", players jab-tap a ball the coach holds out."
    ],
    "coaching": [
      "Wide feet, low hips — sit in a chair.",
      "Slide, don’t cross your feet.",
      "Hands busy — like a goalie.",
      "Eyes on the ball (or the coach’s belly button)."
    ],
    "equipment": [
      "None (optional ball for the coach)"
    ]
  }
}
