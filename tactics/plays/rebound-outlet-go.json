  "notes": {
    "title": "Rebound, Outlet, Go! (also: Outlet Race, Coach Rebound Break, Two-Player Break)",
    "category": "Transition, Rebounding, Passing",
    "ages": "U8, U10",
    "players": "6–12",
    "duration": "8–10 min",
    "objective": "The first fast-break pattern for young players: rebound, pass out to the side, and run the floor for a layup.",
    "setup": [
      "Rebound line under the basket; outlet line on the right wing, near the free-throw line extended",
      "Coach at the free-throw line with a ball"
    ],
    "rules": [
      "Coach tosses the ball off the backboard.",
      "Rebounder grabs it, chins it, pivots to the wing, and calls the outlet player’s name.",
      "Outlet player catches facing the sideline, then dribbles up the court; the rebounder sprints up the middle.",
      "Outlet player passes back to the rebounder near the far basket for a layup (or shoots it themselves at U6).",
      "Players switch lines."
    ],
    "variations": [
      "Easier: walk-through speed; outlet player dribbles all the way and shoots.",
      "Harder: add a chaser defender who starts at the free-throw line after the outlet pass.",
      "Harder: outlet to the left side too."
    ],
    "coaching": [
      "Chin it, pivot, pass — then RUN.",
      "Outlet player: hands up, call for it.",
      "Run wide; stay in your lane.",
      "Finish with a layup, not a long shot."
    ],
    "equipment": [
      "1–2 balls",
      "1 full court (or half court with a cone as the \"far basket\")"
    ],
