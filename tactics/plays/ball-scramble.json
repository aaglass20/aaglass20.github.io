  "notes": {
    "title": "Ball Scramble (also: Fill the Basket, Clean Up the Court, Treasure Dribble)",
    "category": "Conditioning, Ball Handling, Fun",
    "ages": "U6, U8, U10",
    "players": "6–16 (2–4 teams)",
    "duration": "6–8 min",
    "objective": "A high-energy team game: every ball on the floor must be dribbled back to your team’s home base — tons of running and dribbling.",
    "setup": [
      "All balls scattered around the center of the court",
      "Each team has a home base (a corner or a hula hoop) in a corner of the court"
    ],
    "rules": [
      "On \"Go\", players run out, pick up one ball, and dribble it back to home base.",
      "Only one ball at a time, and it must be dribbled the whole way.",
      "When the middle is empty, players may take balls from other teams’ bases (no guarding the base).",
      "After 60–90 seconds, stop; most balls wins."
    ],
    "variations": [
      "Easier: carrying allowed for U6 on the first round.",
      "Harder: weak hand only.",
      "Harder: to bring a ball home, you must first make a layup with it."
    ],
    "coaching": [
      "Head up — watch for traffic.",
      "Protect the ball with your body.",
      "Keep moving; there’s always another ball."
    ],
    "equipment": [
      "1–2 balls per player",
      "Cones or hula hoops for bases"
    ],
    "source": "Drawn by Claude from the drill text"
  }
}