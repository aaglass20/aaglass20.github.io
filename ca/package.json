{
  "name": "ca",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "dev": "cp index.src.html index.html && vite",
    "build": "cp index.src.html index.html && vite build",
    "preview": "vite preview",
    "deploy": "npm run build && rm -rf assets images && cp -r dist/assets assets && cp -r dist/images images && cp dist/index.html index.html && echo 'Deployed!'",
    "restore": "cp index.src.html index.html"
  },
  "dependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router-dom": "^7.0.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "vite": "^6.0.0"
  }
}
